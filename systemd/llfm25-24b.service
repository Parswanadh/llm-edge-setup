[Unit]
Description=LFM2.5-24B-A2B direct llama-server (TurboQuant, max throughput)
After=network-online.target

[Service]
Type=simple
Environment=LD_LIBRARY_PATH=/home/parshu/.local/lib/llama-tq/merged:/home/parshu/.local/lib/ollama-new/cuda_v12
Environment=GGML_BACKEND_PATH=/home/parshu/.local/lib/llama-tq/merged
Environment=GGML_OP_OFFLOAD_MIN_BATCH=32
Environment=HF_HUB_OFFLINE=1
ExecStart=/home/parshu/.local/lib/llama-tq/merged/llama-server -m /home/parshu/.ollama/models/blobs/sha256-89617cc4d3a52e973ee8dea72c7df04285f582107385796ba903f81e540e4afa -ngl 99 --n-cpu-moe 24 -c 131072 -fa on --jinja -t 8 -ctk ktq3 -ctv vtq3 --no-tq-deferred-k --host 127.0.0.1 --port 11436 --no-webui --api-key lfm25-secret --alias lfm25-24b
Restart=on-failure
RestartSec=5
MemoryMax=8G
Nice=5

[Install]
WantedBy=default.target
