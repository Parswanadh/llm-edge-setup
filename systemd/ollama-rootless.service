[Unit]
Description=Ollama 0.40.8 (rootless, user parshu) with MoE expert-offload defaults
After=network-online.target

[Service]
Type=simple
Environment=OLLAMA_MODELS=/home/parshu/.ollama/models
# 11434 is held by the system-wide ollama.service (runs as user "ollama").
# This rootless instance uses 11435 so both can coexist.
Environment=OLLAMA_HOST=127.0.0.1:11435
# Expert-level offload: keep routed-expert weights of the first N layers in CPU RAM/SSD.
# llama-server inherits this via cmd.Env = os.Environ() in llm/llama_server.go.
Environment=LLAMA_ARG_N_CPU_MOE=22
# Let CPU-resident expert matmuls run on GPU during prefill (batch >= threshold)
Environment=GGML_OP_OFFLOAD_MIN_BATCH=1
Environment=OLLAMA_KEEP_ALIVE=30m
Environment=OLLAMA_CONTEXT_LENGTH=32768
Environment=OLLAMA_KV_CACHE_TYPE=q8_0
ExecStart=/home/parshu/.local/lib/ollama-new/ollama serve
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
